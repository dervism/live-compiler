# Copy to .env:  cp .env.example .env

# Which languages to run (comma-separated): python, go, c, cpp, java, rust, haskell — or all
COMPOSE_PROFILES=python

# A fixed token, so you only paste it into the app once. Generate one with:
#   openssl rand -hex 16
LSP_TOKEN=

# LSP_PORT=7998
# MAX_SESSIONS=6
# IDLE_MINUTES=30
# LOG_STDERR=false
